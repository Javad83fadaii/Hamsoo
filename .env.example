# ===========================================================================
# نمونه‌ی متغیرهای محیطی برای استقرار روی Coolify
# این فایل را در پنل کولیفای، در بخش Environment Variables همان سرویس وارد کنید.
# ===========================================================================

# --- تنظیمات اصلی جنگو -----------------------------------------------------
# کلید امنیتی؛ در production حتماً یک مقدار تصادفی و یکتا باشد.
DJANGO_SECRET_KEY=zlqt6aay2%og#_hkr&!jgdn%msw@hr6v05^3m!l!w)tzg2e=8-
DJANGO_DEBUG=False

# دامنه یا آی‌پی‌هایی که سایت با آن‌ها باز می‌شود (با کاما جدا شود)
DJANGO_ALLOWED_HOSTS=87.107.9.100,localhost,127.0.0.1

# آدرس‌های کامل و مورد اعتماد برای فرم‌ها (شامل http/https و پورت)
DJANGO_CSRF_TRUSTED_ORIGINS=http://87.107.9.100:8000

# اگر سایت را روی HTTPS/دامنه بردید، این گزینه را true کنید
DJANGO_SECURE_COOKIES=False

# آدرس عمومی سایت (اختیاری، برای نمایش در لاگ‌ها)
DJANGO_SITE_URL=http://87.107.9.100:8000

# --- داده‌های ماندگار --------------------------------------------------------
# مسیر داده‌های ماندگار داخل کانتینر؛ باید روی یک volume مانت شود
DJANGO_DATA_DIR=/app/data

# پورت داخلی کانتینر
PORT=8000

# --- سرور اجرا --------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- کاربر سوپر یوزر اولیه ---------------------------------------------------
# در اولین بالا آمدن سرویس، اگر کاربر وجود نداشته باشد ساخته می‌شود.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=M.feyzresan@gmail.com
DJANGO_SUPERUSER_PASSWORD=85298754@Ab

# --- محتوای نمونه (اختیاری) --------------------------------------------------
# با true شدن، فقط جدول‌های خالی با محتوای نمونه پر می‌شوند.
DJANGO_SEED_DEMO=false
